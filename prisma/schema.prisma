generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  local
  google
}

enum Role {
  user
  admin
  superadmin
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  googleId  String?  @unique
  provider  Provider @default(local)
  role      Role     @default(user)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
